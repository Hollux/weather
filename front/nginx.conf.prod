# Sert le site Nuxt généré statiquement et proxifie /api vers le backend, en
# retirant le préfixe /api (même convention que le proxy du serveur de dev
# Nuxt, voir front/nuxt.config.js) : le front appelle "/api/xxx" et le backend
# expose "xxx" sans préfixe.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://back_prod:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # La synchro CRange (/crange/sync) télécharge et parse des exports
        # Drive avant de répondre : le défaut de 60s peut ne pas suffire.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri.html $uri/ /200.html;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
