## =========================
## Docker Conf
## =========================

PROJECT_NAME=meteo

FRONT_PORT=8080
BACK_PORT=8081
PHPMYADMIN_PORT=8082
NGINX_PORT=8083
DB_PORT=8084

FRONT_PORT_PROD=8180
BACK_PORT_PROD=8181
PHPMYADMIN_PORT_PROD=8182
NGINX_PORT_PROD=8183
DB_PORT_PROD=8184

## /Docker Conf

## =========================
## Backend Conf
## =========================

# Générer une valeur unique : php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
APP_SECRET=change_me_generate_a_random_32_char_hex
###< symfony/framework-bundle ###
DATABASE_URL="mysql://user:pass@db:3306/db_example"
DATABASE_URL_PROD="mysql://user:pass@db_prod:3306/db_example"
weatherApiKey=your_openweathermap_api_key
weatherApiFreeVersion=true
# Jeton des routes de collecte (/saveminutly, /savedaily) : générer une valeur longue et aléatoire
savKey=change_me_long_random_token
# CORS Configuration pour les ports de Front et de front prod :
CORS_ALLOW_ORIGIN=^http://(localhost:8080|localhost:8180|front:3000)$

# Authentification JWT (lexik/jwt-authentication-bundle) : clés générées par
# `bin/console lexik:jwt:generate-keypair` dans back/config/jwt/ (non versionnées).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Générer une valeur unique : php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_PASSPHRASE=change_me_generate_a_random_passphrase

# Connexion Google (OAuth2) : à créer dans Google Cloud Console > Identifiants
# > ID client OAuth (type "Application Web").
OAUTH_GOOGLE_CLIENT_ID=change_me
OAUTH_GOOGLE_CLIENT_SECRET=change_me
# URL absolue de callback (doit être déclarée telle quelle dans Google Cloud
# Console) : le backend est derrière un reverse-proxy qui ne transmet pas
# X-Forwarded-Proto, Symfony ne peut donc pas déduire seul le https.
OAUTH_GOOGLE_REDIRECT_URI=https://votre-domaine/connect/google/check
OAUTH_GOOGLE_REDIRECT_URI_PROD=https://votre-domaine-prod/connect/google/check

## /Backend Conf

## =========================
## Frontend Conf
## =========================

URL_BACK=http://localhost:8081
URL_BACK_PROD=http://localhost:8181

## /Frontend Conf

## =========================
## Bdd Conf
## =========================

MYSQL_DATABASE=db_example
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_ROOT_PASSWORD=passroot
